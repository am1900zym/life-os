---
// src/layouts/BaseLayout.astro
// Command Center 布局：左侧栏 + 顶栏 + 主内容 + 右栏（可扩展）
import '../styles/global.css';
import '../styles/app-layout.css';
interface Props { title?: string; active?: string; pageTitle?: string }
const { title = 'Life OS', active = '', pageTitle = '今日轨迹' } = Astro.props;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="app-shell">
      <!-- 左侧导航栏 -->
      <aside class="sidebar">
        <div class="sidebar-brand">
          <div class="brand-icon">L</div>
          <span class="brand-name">Life OS</span>
        </div>
        <div class="sidebar-status">
          <span class="status-dot"></span>
          <span>个人模式已启用</span>
        </div>
        <nav class="sidebar-nav">
          <a href="/" class={`nav-link ${active === '/' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            <span>今日轨迹</span>
          </a>
          <a href="/timeline" class={`nav-link ${active === '/timeline' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            <span>人生轨道</span>
          </a>
          <a href="/friends" class={`nav-link ${active === '/friends' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>朋友轨道</span>
          </a>
          <a href="/report" class={`nav-link ${active === '/report' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
            <span>年度报告</span>
          </a>
          <a href="/ai" class={`nav-link ${active === '/ai' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-1H2a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7.5 13a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3m9 0a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3"/></svg>
            <span>AI 助手</span>
          </a>
          <a href="/dental" class={`nav-link ${active === '/dental' ? 'active' : ''}`}>
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5.5c-1.5-2-4.5-2.7-6.7-.8C3.3 6.5 3 10.4 4.6 13.2c.6 1.1 1.3 2.1 2.2 3 .6.6 1 1.3 1 2.1V21h8v-2.7c0-.8.4-1.5 1-2.1.9-.9 1.6-1.9 2.2-3 1.6-2.8 1.3-6.7-.7-8.5-2.2-1.9-5.2-1.2-6.7.8z"/></svg>
            <span>口腔视界</span>
          </a>
        </nav>
        <div class="sidebar-footer">
          <a href="#" class="nav-link">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>设置</span>
          </a>
        </div>
      </aside>

      <!-- 主内容区 -->
      <div class="main-area">
        <!-- 顶栏 -->
        <header class="topbar">
          <div class="topbar-left">
            <h1 class="page-title" id="page-title">{pageTitle}</h1>
            <span class="page-subtitle" id="page-date"></span>
          </div>
          <div class="topbar-right">
            <div class="search-box">
              <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input type="text" id="search-input" placeholder="全局搜索..." autocomplete="off" />
              <div class="search-suggest" id="search-suggest" hidden></div>
            </div>
            <button class="btn-primary quick-add-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              快速新增
            </button>
          </div>
        </header>

        <!-- 页面内容 -->
        <main class="main-content">
          <slot />
        </main>

        <!-- 全局：快速新增模态框 -->
        <div class="modal-overlay" id="quick-add-modal" hidden style="display:none">
          <div class="modal-card modal-wide">
            <div class="modal-header">
              <h3>记录一个瞬间</h3>
              <button type="button" class="modal-close" onclick="const m=document.getElementById('quick-add-modal');m.hidden=true;m.style.display='none'">✕</button>
            </div>
            <form id="quick-add-form">
              <label>类型
                <select name="type" required>
                  <option value="📚 阅读">📚 阅读</option>
                  <option value="📖 阅读">📖 阅读</option>
                  <option value="🏋 健身">🏋 健身</option>
                  <option value="💪 健康">💪 健康</option>
                  <option value="☕ 社交">☕ 社交</option>
                  <option value="✈️ 旅行">✈️ 旅行</option>
                  <option value="💻 学习">💻 学习</option>
                  <option value="🧑💻 创造">🧑💻 创造</option>
                  <option value="💡 想法">💡 想法</option>
                  <option value="🌟 体验">🌟 体验</option>
                </select>
              </label>
              <label>标题
                <input name="title" placeholder="发生了什么" required />
              </label>
              <label>心得 / 细节
                <textarea name="body" rows="3" placeholder="你的感受或细节..."></textarea>
              </label>
              <label>发生日期
                <input type="date" name="occurred_at" />
              </label>
              <label class="file-input-label">
                </label>
              <div class="upload-btn" id="upload-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                上传图片
              </div>
              <input type="file" id="media-input" accept="image/*,video/*" multiple hidden />
              <div class="form-actions">
                <button type="button" class="btn-secondary" id="qa-cancel">取消</button>
                <button type="submit" class="btn-primary">保存</button>
              </div>
              <p class="form-status" id="qa-status"></p>
            </form>
          </div>
        </div>

        <!-- 全局：详情模态框 -->
        <div class="modal-overlay" id="detail-modal" hidden style="display:none">
          <div class="modal-card">
            <div class="modal-header">
              <h3 id="detail-title">标题</h3>
              <button type="button" class="modal-close" onclick="closeDetail()">✕</button>
            </div>
            <div id="detail-body"></div>
            <div class="form-actions">
              <button type="button" class="btn-danger" onclick="window.deleteCurrent()">删除</button>
              <button type="button" class="btn-primary" id="detail-edit-btn" onclick="window.enableEdit()">编辑</button>
            </div>
          </div>
        </div>

        <script>
          // ========= 快速新增 =========
          const qaModal = document.getElementById('quick-add-modal');
          const qaForm = document.getElementById('quick-add-form');
          const qaStatus = document.getElementById('qa-status');
          const qaCancel = document.getElementById('qa-cancel');
          const DEFAULT_USER_ID = 'ec4e72df-c496-4d45-830e-71787bb281a5';

          function openQuickAdd() {
            if (!qaModal) return;
            qaModal.hidden = false;
            qaModal.style.display = '';
          }
          function closeQuickAdd() {
            if (!qaModal) return;
            qaModal.hidden = true;
            qaModal.style.display = 'none';
          }
          document.querySelector('.quick-add-btn')?.addEventListener('click', openQuickAdd);
          qaCancel?.addEventListener('click', closeQuickAdd);

          async function uploadMedia(files) {
            const { supabase } = await import('../lib/supabaseClient');
            const urls = [];
            for (const file of files) {
              const ext = file.name.split('.').pop() || 'bin';
              const path = `moments/${DEFAULT_USER_ID}/${Date.now()}_${Math.random().toString(36).slice(2,8)}.${ext}`;
              const { error } = await supabase.storage.from('life-os').upload(path, file, {
                cacheControl: '3600', upsert: false, contentType: file.type || 'application/octet-stream',
              });
              if (error) continue;
              const { data } = supabase.storage.from('life-os').getPublicUrl(path);
              if (data?.publicUrl) urls.push(data.publicUrl);
            }
            return urls;
          }

          const mediaInput = document.getElementById('media-input');
const uploadBtn = document.getElementById('upload-btn');
uploadBtn?.addEventListener('click', () => mediaInput?.click());
mediaInput?.addEventListener('change', () => {
  qaForm.querySelector('[name=files]')?.remove();
  const hidden = document.createElement('input');
  hidden.type = 'hidden';
  hidden.name = 'files';
  hidden.value = Array.from(mediaInput.files).map(f => f.name).join(',');
  qaForm.appendChild(hidden);
});

qaForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const { supabase } = await import('../lib/supabaseClient');
            if (!supabase) { qaStatus.textContent = 'Supabase 未配置'; return; }
            const fd = new FormData(qaForm);
            const type = String(fd.get('type') || '').trim();
            const title = String(fd.get('title') || '').trim();
            const body = String(fd.get('body') || '').trim();
            const occurred_at = String(fd.get('occurred_at') || '') ? new Date(String(fd.get('occurred_at')).trim()).toISOString() : new Date().toISOString();
            if (!type || !title) { qaStatus.textContent = '请填写类型和标题'; return; }
            qaStatus.textContent = '保存中...';
            const media = await uploadMedia(Array.from(qaForm.querySelectorAll('input[type=file]')[0]?.files || []));
            const { error } = await supabase.from('moments').insert({
              user_id: DEFAULT_USER_ID, type, title, body: body || null, occurred_at, visibility: 'private', media_urls: media,
            });
            if (error) {
              qaStatus.textContent = '保存失败：' + error.message;
              qaStatus.className = 'form-status error';
              return;
            }
            qaStatus.textContent = '✓ 已保存';
            qaStatus.className = 'form-status success';
            qaForm.reset();
            setTimeout(() => { closeQuickAdd(); qaStatus.textContent = ''; qaStatus.className = 'form-status'; }, 800);
            window.dispatchEvent(new CustomEvent('lifeos:refresh'));
          });

          // ========= 搜索建议 =========
          const searchInput = document.getElementById('search-input');
          const searchSuggest = document.getElementById('search-suggest');
          const searchDebounce = (fn, wait) => {
            let t; return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), wait); };
          };

          async function searchMoments(term) {
            const { supabase } = await import('../lib/supabaseClient');
            if (!supabase) return [];
            const { data } = await supabase
              .from('moments')
              .select('id,title,type,occurred_at,body')
              .or(`title.ilike.%${term}%,body.ilike.%${term}%,type.ilike.%${term}%`)
              .order('occurred_at', { ascending: false })
              .limit(8);
            return data || [];
          }

          const renderSearch = searchDebounce(async (value) => {
            if (!value || !searchSuggest) { searchSuggest.hidden = true; searchSuggest.innerHTML = ''; return; }
            const rows = await searchMoments(value);
            if (!rows.length) { searchSuggest.hidden = true; searchSuggest.innerHTML = ''; return; }
            searchSuggest.innerHTML = rows.map((r) => `
              <div class="search-item" data-id="${r.id}">
                <span>${r.title}</span>
                <span class="si-meta">${r.type} · ${new Date(r.occurred_at).toLocaleDateString('zh-CN')}</span>
              </div>
            `).join('');
            searchSuggest.hidden = false;
          }, 180);

          searchInput?.addEventListener('input', (e) => renderSearch(e.target.value));
          searchInput?.addEventListener('focus', () => { if (searchInput.value.trim()) renderSearch(searchInput.value.trim()); });
          document.addEventListener('click', (e) => {
            if (!searchSuggest?.contains(e.target) && e.target !== searchInput) {
              searchSuggest.hidden = true;
            }
          });

          // ========= 详情：查看/编辑/评论 =========
          const detailModal = document.getElementById('detail-modal');
          const detailTitle = document.getElementById('detail-title');
          const detailBody = document.getElementById('detail-body');
          const detailEditBtn = document.getElementById('detail-edit-btn');
          let currentDetail = null;

          async function openDetail(moment) {
            currentDetail = moment;
            detailTitle.textContent = moment.title;
            detailBody.innerHTML = `
              <div class="detail-meta">
                <span class="detail-visibility">${moment.visibility === 'public' ? '公开' : '私密'}</span>
                <span class="detail-date">${new Date(moment.occurred_at).toLocaleString('zh-CN')}</span>
              </div>
              ${Array.isArray(moment.media_urls) && moment.media_urls.length ? `
                <div class="detail-media">
                  ${moment.media_urls.map((u) => /\\.(mp4|mov)$/i.test(u) ? `<video src="${u}" controls></video>` : `<img src="${u}" alt="media" />`).join('')}
                </div>
              ` : ''}
              <p class="detail-text">${moment.body || ''}</p>
              <form class="detail-edit-form" id="detail-edit-form">
                <label>类型
                  <select name="type" required>
                    <option value="📚 阅读">📚 阅读</option>
                    <option value="🏋 健身">🏋 健身</option>
                    <option value="☕ 社交">☕ 社交</option>
                    <option value="✈️ 旅行">✈️ 旅行</option>
                    <option value="💻 学习">💻 学习</option>
                    <option value="💡 想法">💡 想法</option>
                    <option value="🌟 体验">🌟 体验</option>
                  </select>
                </label>
                <label>标题
                  <input name="title" value="${moment.title.replace(/"/g, '&quot;')}" required />
                </label>
                <label>心得
                  <textarea name="body" rows="3">${moment.body || ''}</textarea>
                </label>
                <label>日期
                  <input type="date" name="occurred_at" value="${moment.occurred_at ? new Date(moment.occurred_at).toISOString().slice(0,10) : ''}" />
                </label>
                <label>可见性
                  <select name="visibility">
                    <option value="private">私密</option>
                    <option value="public">公开</option>
                  </select>
                </label>
                <label>标签 (用逗号分隔)
                  <input name="tags" value="${Array.isArray(moment.tags) ? moment.tags.join(',') : ''}" placeholder="如：学习, 重要" />
                </label>
                <div class="form-actions">
                  <button type="button" class="btn-secondary" onclick="window.cancelEdit()">取消</button>
                  <button type="submit" class="btn-primary">保存修改</button>
                </div>
              </form>
              <div class="comments-section" id="comments-section">
                <div class="comments-title">评论</div>
                <div class="comment-list" id="comment-list"></div>
                <form class="comment-form" id="comment-form">
                  <input type="text" name="content" placeholder="写评论..." required />
                  <button type="submit">发送</button>
                </form>
              </div>
            `;
            detailModal.hidden = false;
            detailModal.style.display = '';

            window.enableEdit = () => editForm?.classList.add('open');
            window.cancelEdit = () => editForm?.classList.remove('open');
            const editForm = document.getElementById('detail-edit-form');
            void editForm; // Ensure editForm reference exists
            editForm?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const { supabase } = await import('../lib/supabaseClient');
              if (!supabase || !currentDetail) return;
              const fd = new FormData(editForm);
              const tagsRaw = String(fd.get('tags') || '');
              const tags = tagsRaw.split(/[,，]/).map((t) => t.trim()).filter(Boolean);
              const { error, count } = await supabase.from('moments').update({
                type: String(fd.get('type') || '💡 想法').trim(),
                title: String(fd.get('title') || '').trim(),
                body: String(fd.get('body') || '').trim() || null,
                occurred_at: String(fd.get('occurred_at') || '') ? new Date(String(fd.get('occurred_at'))).toISOString() : currentDetail.occurred_at,
                visibility: String(fd.get('visibility') || 'private').trim(),
                tags,
              }).eq('id', currentDetail.id);
              if (error) { alert('保存失败：' + error.message); return; }
              if (count === 0) { alert('保存失败：没有匹配的记录（可能是 Supabase RLS 策略缺失，需为 moments 表添加 UPDATE 策略）。'); return; }
              window.dispatchEvent(new CustomEvent('lifeos:refresh'));
              closeDetail();
            }, { once: true });

            const commentForm = document.getElementById('comment-form');
            const commentList = document.getElementById('comment-list');
            const loadComments = async () => {
              try {
                const { supabase } = await import('../lib/supabaseClient');
                if (!supabase) { commentList.innerHTML = '<p style="color:#8A93A6;font-size:13px;">评论不可用</p>'; return; }
                const { data } = await supabase.from('comments').select('*').eq('moment_id', currentDetail.id).order('created_at', { ascending: true });
                const rows = data || [];
                if (!rows.length) { commentList.innerHTML = '<p style="color:#8A93A6;font-size:13px;">暂无评论</p>'; return; }
                commentList.innerHTML = rows.map((c) => `
                  <div class="comment-item">
                    <div class="comment-avatar" style="background:${c.user_id === DEFAULT_USER_ID ? '#4F7CF7' : '#2DD4A8'}">${(c.nickname || 'U')[0]?.toUpperCase()}</div>
                    <div class="comment-bubble">
                      <div class="cb-name">${escapeHtml(c.nickname || '用户')}</div>
                      <div class="cb-text">${escapeHtml(c.content)}</div>
                      <div class="cb-time">${new Date(c.created_at).toLocaleString('zh-CN')}</div>
                    </div>
                  </div>
                `).join('');
              } catch (err) {
                commentList.innerHTML = '<p style="color:#8A93A6;font-size:13px;">评论加载失败</p>';
              }
            };
            await loadComments();
            commentForm?.addEventListener('submit', async (e) => {
              e.preventDefault();
              const { supabase } = await import('../lib/supabaseClient');
              if (!supabase || !currentDetail) return;
              const fd = new FormData(commentForm);
              const content = String(fd.get('content') || '').trim();
              if (!content) return;
              const { error } = await supabase.from('comments').insert({ moment_id: currentDetail.id, user_id: DEFAULT_USER_ID, nickname: 'Amanda', content });
              if (error) { alert('评论失败：' + error.message); return; }
              commentForm.reset();
              loadComments();
            }, { once: true });
          }

          function closeDetail() {
            if (!detailModal) return;
            detailModal.hidden = true;
            detailModal.style.display = 'none';
            currentDetail = null;
          }

          window.deleteCurrent = async function () {
            const targetId = currentDetail?.id;
            if (!targetId) { alert('未找到该记录，请重新打开详情再删除'); return; }
            if (!confirm('确定删除这条记录吗？此操作不可撤销。')) return;
            const { supabase } = await import('../lib/supabaseClient');
            if (!supabase) { alert('Supabase 未配置'); return; }
            const { error, count } = await supabase.from('moments').delete({ count: 'exact' }).eq('id', targetId);
            if (error) { alert('删除失败：' + error.message); return; }
            if (count === 0) { alert('删除失败：没有匹配的记录。\n很可能是 Supabase RLS 策略缺失——请在 Supabase SQL Editor 执行项目中的 supabase/fix-rls-moments.sql 为 moments 表添加 DELETE 策略。'); return; }
            closeDetail();
            window.dispatchEvent(new CustomEvent('lifeos:refresh'));
          };

          // 暴露 openDetail 给页面内卡片点击使用
          window.openDetail = openDetail;

          function escapeHtml(s) {
            return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' })[c]);
          }

          window.addEventListener('lifeos:refresh', () => {});
        </script>
      </div>

      <!-- 右栏（预留扩展） -->
