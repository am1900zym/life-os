---
// src/layouts/BaseLayout.astro
import '../styles/global.css';
interface Props { title?: string }
const { title = 'Life OS' } = Astro.props;
---
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <nav class="nav-bar">
        <a href="/" class="nav-item">🏠</a>
        <a href="/timeline" class="nav-item active">🛤</a>
        <a href="/friends" class="nav-item">👥</a>
        <a href="/report" class="nav-item">📊</a>
        <a href="/ai" class="nav-item">🤖</a>
      </nav>
    </footer>
  </body>
</html>
