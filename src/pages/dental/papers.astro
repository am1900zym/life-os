  <!-- ===== 筛选 + 分页邏輯 ===== -->
  <script>
    const PAGE_SIZE = 20;
    let currentPage = 1;
    let filteredPapers = [];     // 经过期刊筛选后 (前端) 或分页查询后 (Supabase) 的全部结果
    let isClientSideFilter = false; // 是否在前端做筛选 (Supabase 路径下為 false)

    // 从 Supabase 加载 (分页靠 offset/limit)
    async function loadFromSupabase(page = 1, journals = []) {
      const mod = await import('../../lib/supabaseClient');
      if (!mod.supabase) return false;

      const from = (page - 1) * PAGE_SIZE;
      let query = mod.supabase.from('dental_papers')
        .select('*', { count: 'exact' })
        .order('published_on', { ascending: false })
        .range(from, from + PAGE_SIZE - 1);

      // 期刊筛选: 始终生效 (in-filter)
      if (journals.length > 0 && journals.length < dentalJournals.length) {
        query = query.in('journal', journals);
      }

      const { data, error, count } = await query;
      if (error) throw error;

      filteredPapers = data || [];
      renderList(filteredPapers);
      renderPager(page, count || 0);
      return true;
    }

    // 从静态 JSON 加载 + 本地筛选 (兜底)
    async function loadFromJson() {
      // 尝试远程 JSON (部署在 /data/)
      let papers = [];
      try {
        const resp = await fetch('/data/dental-papers-fresh.json');
        papers = await resp.json();
      } catch {
        papers = window.__dentalPapersFallback || []; // 內嵌兜底
      }
      filteredPapers = papers;           // 全量
      isClientSideFilter = true;         // 前端篩選
      const page = 1;
      const pageStart = 0, pageEnd = PAGE_SIZE;
      const pageData = filteredPapers.slice(pageStart, pageEnd);
      renderList(pageData);
      renderPager(page, filteredPapers.length, PAGE_SIZE, true);
    }

    function renderList(items) {
      const container = document.getElementById('papers-container');
      if (!container) return;
      container.innerHTML = items.map(p => renderPaperToHtml(p)).join('');
      bindPaperLinks();
    }

    function renderPaperToHtml(p) {
      const journalZh = p.journal_zh ? `<span class="paper-journal-zh">/ ${escapeHtml(p.journal_zh)}</span>` : '';
      const oaBadge = p.is_oa ? `<span class="oa-badge" title="开放获取">● OA 全文</span>` : '';
      const linkUrl = escapeHtml(p.full_text_url || p.url || '#');
      const linkText = p.is_oa ? '📄 阅读 OA 全文' : '🔗 PubMed 原文';
      const titleZh = p.title_zh ? `<div class="paper-title-zh">${escapeHtml(p.title_zh)}</div>` : '';
      // 大小写不敏感查找中文映射
      const zhOf = (t) => TAG_ZH_MAP[t] || TAG_ZH_MAP[t.toLowerCase()] || TAG_ZH_MAP[t.charAt(0).toUpperCase() + t.slice(1)] || '';
      // 双语标签: 有中文映射 → "中文 · English", 无映射 (MeSH 关键词) → 仅英文
      const tagsHtml = Array.isArray(p.tags) && p.tags.length
        ? p.tags.map(t => {
            const zh = zhOf(t);
            const label = zh ? `${zh} · ${escapeHtml(t)}` : escapeHtml(t);
            return `<span class="paper-tag" ${zh ? 'style="background:rgba(79,124,247,.10);color:#4f7cf7;border:1px solid rgba(79,124,247,.3)"' : 'style="background:var(--card);border:1px solid var(--border);color:var(--muted)"'}>${label}</span>`;
          }).join('') : '';
      const doi = p.doi ? `<span class="paper-doi">doi: ${escapeHtml(p.doi)}</span>` : '';
      // NEW 标签: 仅今天的文章
      const todayStr = new Date().toISOString().slice(0, 10);
      const isToday = (p.published_on || '').slice(0, 10) === todayStr;
      const newBadge = isToday ? `<span class="new-badge" style="font-size:11px;color:#e65100;border:1px solid rgba(230,81,0,.3);background:rgba(230,81,0,.08);padding:1px 8px;border-radius:999px;margin-left:8px;font-weight:600">NEW</span>` : '';
      return `
        <article class="paper-item" data-journal="${escapeHtml(p.journal)}" data-tags="${escapeHtml((p.tags||[]).join(','))}">
          <div class="paper-meta">
            <span class="paper-journal" style="color:var(--brand);font-weight:500">${escapeHtml(p.journal)}</span>
            ${journalZh}
            ${oaBadge}
            ${newBadge}
            <span style="margin-left:auto;font-size:12px;color:var(--muted)">${escapeHtml((p.published_on || '').slice(5,10))}</span>
          </div>
          <h3 class="paper-title" style="margin:6px 0;font-family:'Crimson Pro',serif;font-size:16px;line-height:1.4">
            <a href="${linkUrl}" target="_blank" rel="noopener" title="点击查看原文">${escapeHtml(p.title)}</a>
          </h3>
          ${titleZh}
          <div class="paper-authors" style="font-size:13px;color:var(--muted);margin:4px 0">${escapeHtml(p.authors || '')}</div>
          ${p.abstract ? `<p class="paper-abstract" style="font-size:13px;color:var(--fg);margin:6px 0;line-height:1.5">${escapeHtml(p.abstract.slice(0,300))}${p.abstract.length>300?'...':''}</p>` : ''}
          <div class="paper-tags" style="margin:8px 0">${tagsHtml}</div>
          <div class="paper-links">
            <a class="paper-link" href="${linkUrl}" target="_blank" rel="noopener">${linkText}</a>
            ${doi}
          </div>
        </article>
      `;
    }

    // 分页渲染
    function renderPager(page, total, size = PAGE_SIZE, clientSide = false) {
      const totalPages = size > 0 ? Math.ceil(total / size) : 1;
      currentPage = page;
      document.getElementById('current-page').textContent = page;
      document.getElementById('total-pages').textContent = totalPages;
      document.getElementById('pagination-info').textContent = `第 ${page} 页，共 ${totalPages} 页`;
      document.getElementById('papers-status').innerHTML = isClientSideFilter
        ? `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#2e7d32"></span>● 实时数据 · PubMed 追踪 · ${total} 篇`
        : `○ 静态 JSON · ${total} 篇`;

      const nav = document.getElementById('pager-nav');
      nav.innerHTML = `
        <button class="pager-btn" data-page="home" ${page<=1?'disabled':''}>首页</button>
        <button class="pager-btn" data-page="prev" ${page<=1?'disabled':''}>← 上一页</button>
        <span style="padding:0 12px;font-size:13px;color:var(--muted)">${page} / ${totalPages}</span>
        <button class="pager-btn" data-page="next" ${page>=totalPages?'disabled':''}>下一页 →</button>
        <button class="pager-btn" data-page="end" ${page>=totalPages?'disabled':''}>末页</button>
      `;
      nav.querySelectorAll('.pager-btn').forEach(btn => {
        btn.addEventListener('click', onPageClick);
      });
    }

    function onPageClick(e) {
      const target = e.currentTarget.dataset.page;
      const total = parseInt(document.getElementById('total-pages').textContent);
      let next = currentPage;
      switch(target) {
        case 'home': next = 1; break;
        case 'end':  next = total; break;
        case 'prev': next = Math.max(1, currentPage - 1); break;
        case 'next': next = Math.min(total, currentPage + 1); break;
      }
      if (next === currentPage) return;
      loadPage(next);
    }

    async function loadPage(page) {
      const journals = [...document.querySelectorAll('#journal-checks input:checked')].map(cb => cb.value);
      if (isClientSideFilter) {
        // 本地篩選 → 本地分页
        const all = window._allPapers.filter(p => journals.length === 0 || journals.includes(p.journal));
        const from = (page - 1) * PAGE_SIZE;
        const pageData = all.slice(from, from + PAGE_SIZE);
        renderList(pageData);
        renderPager(page, all.length);
      } else {
        // Supabase 篩選 → 遠端分页
        await loadFromSupabase(page, journals);
      }
    }

    function bindFilters() {
      const checkboxes = [...document.querySelectorAll('#journal-checks input[type=checkbox]')];
      checkboxes.forEach(c => c.addEventListener('change', applyFilter));
      document.querySelectorAll('.fp-action').forEach(btn => {
        btn.addEventListener('click', () => {
          const action = btn.getAttribute('data-action');
          checkboxes.forEach(c => { c.checked = action === 'all'; });
          applyFilter();
        });
      });
    }

    async function applyFilter() {
      const selected = [...document.querySelectorAll('#journal-checks input:checked')].map(cb => cb.value);
      document.getElementById('filter-status').textContent = `已选 ${selected.length} / ${dentalJournals.length} 本期刊`;

      if (isClientSideFilter) {
        const all = window._allPapers.filter(p => selected.length === 0 || selected.includes(p.journal));
        window._filtered = all;
        const from = 0;
        const pageData = all.slice(from, from + PAGE_SIZE);
        renderList(pageData);
        renderPager(1, all.length);
      } else {
        // Supabase 路徑: 重新查詢第一頁
        await loadFromSupabase(1, selected);
      }
    }

    function bindPaperLinks() {
      // 標籤點擊篩選 (可選: 點一個標籤篩選同類)
      document.querySelectorAll('.paper-tag, .paper-tag-zh').forEach(tag => {
        tag.style.cursor = 'default';
      });
    }

    // 起動
    (async () => {
      const ok = await loadFromSupabase(1);
      if (!ok) {
        // 降级到静态 JSON (本地篩選)
        await loadFromJson();
      } else {
        bindFilters();
      }
      // 儲存全量資料到全局 (前端篩選用)
      if (isClientSideFilter && window._allPapers) {
        bindFilters();
      }
    })();
  </script>
</DentalLayout>
