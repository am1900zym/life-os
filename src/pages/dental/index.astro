---
// src/pages/dental/index.astro — 今日口腔: 只显示当天文章 (Supabase 实时)
// 未来其他板块 (病例/护理/视频) 的当天信息也汇入此页
import DentalLayout from '../../layouts/DentalLayout.astro';
import { dentalJournals } from '../../data/dentalData';
---

<DentalLayout title="口腔视界 — 今日口腔" active="/dental" pageTitle="今日口腔" pageSub="口腔医学 · 口腔护理，每日更新。">
  <!-- 统计条 (动态加载后更新) -->
  <section class="stat-bar">
    <div class="stat-card">
      <div class="stat-num" id="stat-today">…</div>
      <div class="stat-label">今日收录论文</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">{dentalJournals.length}</div>
      <div class="stat-label">追踪期刊</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">5</div>
      <div class="stat-label">护理要点</div>
    </div>
    <div class="stat-card">
      <div class="stat-num">4</div>
      <div class="stat-label">临床病例</div>
    </div>
  </section>

  <!-- 口腔塔罗（参考 Paper Tarot） -->
  <section class="tarot-zone" id="tarot-zone">
    <h2 class="tarot-title">口腔塔罗</h2>
    <p class="tarot-sub">抽三张卡片 — 档案给出今天的口腔知识答案。</p>
    <div class="tarot-cards">
      <div class="tarot-card" data-card="0">🃏<span class="tc-label">CARD 1</span></div>
      <div class="tarot-card" data-card="1">🃏<span class="tc-label">CARD 2</span></div>
      <div class="tarot-card" data-card="2">🃏<span class="tc-label">CARD 3</span></div>
    </div>
    <div class="tarot-result" id="tarot-result">点击卡片，抽取今日知识。</div>
    <button class="tarot-shuffle" id="tarot-shuffle" type="button">洗牌重抽 →</button>
  </section>

  <!-- 今日论文 (Supabase 实时: 仅当天) -->
  <section class="paper-section">
    <div class="date-group">
      <span class="dg-date">Today's Papers</span>
      <span class="dg-count">今日新论文 · 来自 PubMed</span>
    </div>
    <div class="papers-container" id="today-papers">
      <p style="color:var(--muted);padding:12px">加载今日论文…</p>
    </div>
    <p style="font-size:12px;color:var(--muted);margin-top:8px" id="today-empty" hidden>
      今天暂无新论文（PubMed 出版可能有延迟，明早 08:00 自动同步）。
    </p>
  </section>
</DentalLayout>

<script is:inline>
  // 中文标签映射 (与论文页一致, 精简版)
  const TAG_ZH = {
    "Article": "期刊文章", "Review": "综述", "Systematic Review": "系统评价",
    "Meta-Analysis": "荟萃分析", "RCT": "随机对照", "Clinical Trial": "临床试验",
    "Cross-Sectional": "横断面研究", "Cohort": "队列研究", "Case Report": "病例报告",
    "Guideline": "指南", "Editorial": "社论", "Letter": "来信",
    "oral health": "口腔健康", "dental caries": "龋齿", "periodontitis": "牙周炎",
    "nursing": "护理", "nurses": "护士", "children": "儿童", "adolescents": "青少年",
    "quality of life": "生活质量", "pain": "疼痛", "prevention": "预防",
    "randomized controlled trial": "随机对照试验", "qualitative study": "质性研究",
    "systematic review": "系统评价", "meta-analysis": "荟萃分析", "dentistry": "牙科学",
  };
  function esc(s) { return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]); }

  (async function () {
    const todayStr = new Date().toISOString().slice(0, 10);
    const start = todayStr + 'T00:00:00', end = todayStr + 'T23:59:59';
    let papers = [];
    try {
      const mod = await import('../../lib/supabaseClient');
      if (mod.supabase) {
        const { data, error, count } = await mod.supabase
          .from('dental_papers')
          .select('*', { count: 'exact' })
          .gte('published_on', start)
          .lte('published_on', end)
          .order('published_on', { ascending: false })
          .limit(30);
        if (!error) papers = data || [];
      }
    } catch (e) { /* 降级空列表 */ }

    const stat = document.getElementById('stat-today');
    if (stat) stat.textContent = papers.length;

    const container = document.getElementById('today-papers');
    const empty = document.getElementById('today-empty');
    if (!container) return;

    if (!papers.length) {
      container.innerHTML = '';
      if (empty) empty.hidden = false;
      return;
    }

    container.innerHTML = papers.map(p => {
      const journalZh = p.journal_zh ? `<span style="color:var(--muted);font-size:12px;margin-left:6px">/ ${esc(p.journal_zh)}</span>` : '';
      const oa = p.is_oa ? `<span style="background:rgba(46,125,50,.10);color:#2e7d32;border:1px solid rgba(46,125,50,.3);padding:1px 8px;border-radius:999px;font-size:11px;font-weight:600;margin-left:8px">● OA 全文</span>` : '';
      const tags = (p.tags || []).map(t => {
        const zh = TAG_ZH[t] || '';
        const label = zh ? `<b>${esc(zh)}</b> · ${esc(t)}` : esc(t);
        const style = zh ? 'background:rgba(79,124,247,.10);color:#4f7cf7;border:1px solid rgba(79,124,247,.3)' : 'background:var(--card);border:1px solid var(--border);color:var(--muted)';
        return `<span style="display:inline-block;${style};padding:1px 8px;border-radius:999px;font-size:11px;margin-right:6px;margin-bottom:3px">${label}</span>`;
      }).join('');
      const titleZh = p.title_zh ? `<div style="font-size:14px;color:var(--muted);margin:4px 0 8px;font-weight:500">${esc(p.title_zh)}</div>` : '';
      const link = esc(p.full_text_url || p.url || '#');
      const linkText = p.is_oa ? '📄 阅读 OA 全文' : '🔗 PubMed 原文';
      return `
        <article class="paper-item" style="background:var(--card);border:1px solid var(--border);border-radius:14px;padding:18px;margin-bottom:14px">
          <div class="paper-meta">
            <span style="color:var(--brand);font-weight:500">${esc(p.journal)}</span>${journalZh}${oa}
            <span style="float:right;font-size:12px;color:var(--muted)">${esc((p.published_on||'').slice(5,10))}</span>
          </div>
          <h3 class="paper-title" style="margin:6px 0;font-size:16px;line-height:1.4"><a href="${link}" target="_blank" rel="noopener">${esc(p.title)}</a></h3>
          ${titleZh}
          <div style="font-size:13px;color:var(--muted)">${esc(p.authors||'')}</div>
          <div class="paper-tags" style="margin:8px 0">${tags}</div>
          <div><a href="${link}" target="_blank" rel="noopener" style="font-size:12.5px;font-weight:600;color:var(--brand,#4f7cf7)">${linkText}</a></div>
        </article>`;
    }).join('');
  })();
</script>

<script is:inline>
  // ===== 口腔塔罗：抽卡即给答案 =====
  const TIPS = [
    { title: '预防龋齿', body: '儿童氟化钠漱口：6 岁以上每日 1 次，含漱 1 分钟后吐出，30 分钟内不进食不饮水。' },
    { title: '拔牙术后', body: '纱卷加压咬合 30 分钟；持续出血检查牙槽窝，必要时明胶海绵填塞，联系医生。' },
    { title: '老年患者', body: '治疗前常规测血压：收缩压 ≥180mmHg 或舒张压 ≥110mmHg 应暂缓择期治疗。' },
    { title: '糖尿病管理', body: '择期治疗前空腹血糖建议 ≤7.8mmol/L，餐后 2h ≤10mmol/L，候诊区备糖果防低血糖。' },
    { title: '正畸清洁', body: '固定矫治期间餐后 3 分钟内清洁，正畸小头刷 + 牙间刷 + 冲牙器组合使用。' },
    { title: '根管充填', body: '恰填标准：充填物距根尖 1mm 内，致密无空隙，根尖周无透射影。' },
    { title: '种植术前', body: 'CBCT 评估剩余牙槽嵴高度与上颌窦状态，残余骨高度 <4mm 需考虑提升术。' },
    { title: '口腔癌早筛', body: '口腔白斑、红斑、长期不愈溃疡（>2 周）应转诊活检，警惕高危部位。' },
    { title: '四手操作', body: '护士与医生间距 50cm，器械传递在患者口腔外 10cm 范围内进行，减少重复取放。' },
    { title: '消毒隔离', body: '手机、车针一人一用一消毒；治疗前后台面用含氯消毒剂或 75% 酒精擦拭。' },
  ];

  const cards = document.querySelectorAll('.tarot-card');
  const result = document.getElementById('tarot-result');

  function pick() {
    const idx = Math.floor(Math.random() * TIPS.length);
    return TIPS[idx];
  }

  function drawCard(cardEl) {
    if (cardEl.classList.contains('flipped')) return;
    cardEl.classList.add('flipped');
    const tip = pick();
    cardEl.innerHTML = `<span style="font-size:26px">🦷</span><span class="tc-label" style="font-size:9px">${tip.title}</span>`;
    if (result) {
      result.innerHTML = `<span class="tr-title">${tip.title}</span><br>${tip.body}`;
    }
  }

  cards.forEach((card) => {
    card.addEventListener('click', () => drawCard(card));
  });

  const shuffle = document.getElementById('tarot-shuffle');
  shuffle?.addEventListener('click', () => {
    cards.forEach((card) => {
      card.classList.remove('flipped');
      card.innerHTML = `🃏<span class="tc-label">CARD ${card.dataset.card}</span>`;
    });
    result.innerHTML = '点击卡片，抽取今日知识。';
  });
</script>
