---
import BaseLayout from '../layouts/BaseLayout.astro';
const CURRENT_NICKNAME = 'Amanda';
const CURRENT_AVATAR_COLOR = '#4F7CF7';
---

<BaseLayout title="Life OS" active="/">
  <section class="hero">
    <div class="avatar">A</div>
    <h1 class="user-name">Amanda</h1>
    <p class="user-date">{import.meta.env.PUBLIC_NOW_DATE || new Date().toLocaleDateString('zh-CN', {year:'numeric',month:'long',day:'numeric'})}</p>
    <p class="user-prompt">今天，你想记录什么？</p>
    <button class="btn-add" id="btn-add">+ 添加人生瞬间</button>
  </section>

  <section class="today">
    <h2 class="section-title">今日轨迹</h2>
    <p class="data-status" id="data-status"></p>
    <div class="moment-list" id="moment-list">
      <article class="moment-card">
        <span class="moment-type">📚 阅读</span>
        <h3>《时间游戏》</h3>
        <p class="moment-meta">今天</p>
      </article>
      <article class="moment-card">
        <span class="moment-type">🏋 健身</span>
        <h3>力量训练 60 分钟</h3>
        <p class="moment-meta">今天</p>
      </article>
      <article class="moment-card">
        <span class="moment-type">☕ 社交</span>
        <h3>朋友聚餐</h3>
        <p class="moment-meta">今天</p>
      </article>
    </div>
  </section>

  <section class="ai-today">
    <h2 class="section-title">AI 今日一句话</h2>
    <div class="ai-card">
      <p>“今天的你，在持续构建长期能力。”</p>
    </div>
  </section>

  <section class="growth">
    <h2 class="section-title">本月成长</h2>
    <div class="bar-list">
      <div class="bar-row">
        <span class="bar-label">学习</span>
        <div class="bar-track"><div class="bar-fill blue" style="width: 87%"></div></div>
      </div>
      <div class="bar-row">
        <span class="bar-label">健康</span>
        <div class="bar-track"><div class="bar-fill green" style="width: 65%"></div></div>
      </div>
      <div class="bar-row">
        <span class="bar-label">社交</span>
        <div class="bar-track"><div class="bar-fill gold" style="width: 72%"></div></div>
      </div>
    </div>
  </section>

  <!-- 添加瞬间表单 -->
  <div class="modal-overlay" id="add-modal" hidden style="display:none">
    <div class="modal-card modal-wide">
      <div class="modal-header">
        <h3>记录一个瞬间</h3>
        <button type="button" class="modal-close" onclick="var m=document.getElementById('add-modal');m.hidden=true;m.style.display='none'">✕</button>
      </div>
      <form id="add-form">
        <label>类型
          <select name="type" required>
            <option value="📚 阅读">📚 阅读</option>
            <option value="📖 阅读">📖 阅读</option>
            <option value="🏋 健身">🏋 健身</option>
            <option value="💪 健康">💪 健康</option>
            <option value="☕ 社交">☕ 社交</option>
            <option value="✈️ 旅行">✈️ 旅行</option>
            <option value="💻 学习">💻 学习</option>
            <option value="🧑💻 创造">🧑💻 创造</option>
            <option value="💡 想法">💡 想法</option>
            <option value="🌟 体验">🌟 体验</option>
          </select>
        </label>
        <label>标题
          <input name="title" placeholder="发生了什么" required />
        </label>
        <label>心得 / 细节
          <textarea name="body" rows="3" placeholder="你的感受或细节..."></textarea>
        </label>
        <label>发生日期
          <input type="date" name="occurred_at" />
        </label>
        <label>图片 / 视频
          <input type="file" id="media-files" accept="image/*,video/*" multiple />
          <span class="file-hint">支持多选图片或视频</span>
          <ul class="file-list" id="file-list"></ul>
        </label>
        <div class="form-actions">
          <button type="button" class="btn-secondary" id="btn-cancel">取消</button>
          <button type="submit" class="btn-primary">保存</button>
        </div>
        <p class="form-status" id="form-status"></p>
      </form>
    </div>
  </div>

  <!-- 瞬间详情弹窗已关闭，如需恢复可保留此结构 -->
</BaseLayout>

<style>
  .data-status { font-size: 12px; color: #8A93A6; margin: 0 0 12px; }
  .data-status.live { color: #4F7CF7; font-weight: 500; }
  .data-status.demo { color: #B0B7C4; }
  .moment-body { font-size: 13px; color: #8A93A6; margin: 4px 0 0; }
</style>

<script>
  import { supabase } from '../lib/supabaseClient';

  const DEFAULT_USER_ID = 'ec4e72df-c496-4d45-830e-71787bb281a5';
  const CURRENT = { userId: 'local-' + DEFAULT_USER_ID, nickname: 'Amanda', color: '#4F7CF7' };

  function escapeHtml(s: unknown): string {
    return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' } as Record<string, string>)[c]);
  }

  // ====== 通用：打开/关闭 overlay ======
  function openOverlay(id: string) {
    const m = document.getElementById(id);
    if (m) { m.hidden = false; m.style.display = ''; }
  }
  function closeOverlay(id: string) {
    const m = document.getElementById(id);
    if (m) { m.hidden = true; m.style.display = 'none'; }
  }

  // ====== 列表渲染 ======
  // 详情弹窗入口已关闭；如需恢复请回滚到包含 openDetail() 的版本

  function renderMoments(moments: any[]) {
    const list = document.getElementById('moment-list');
    const status = document.getElementById('data-status');
    if (!list) return;
    const items = (moments || []).map((m) => `
      <article class="moment-card" data-id="${escapeHtml(m.id)}">
        <span class="moment-type">${escapeHtml(m.type ?? '💡 想法')}</span>
        <h3>${escapeHtml(m.title)}</h3>
        ${m.body ? `<p class="moment-body">${escapeHtml(m.body)}</p>` : ''}
      </article>
    `).join('');
    list.innerHTML = items || '<p style="color:#8A93A6;font-size:14px;">暂无记录</p>';
    if (status) {
      status.textContent = `● 已接入 Supabase · 共 ${moments.length} 条瞬间`;
      status.className = 'data-status live';
    }
  }

  function showDemo(reason?: string) {
    const status = document.getElementById('data-status');
    if (status) {
      status.textContent = reason ? `○ 演示数据（${reason}）` : '○ 演示数据（未配置 Supabase 或暂无记录）';
      status.className = 'data-status demo';
    }
  }

  async function loadMoments() {
    if (!supabase) { showDemo('Supabase 未配置'); return; }
    const { data, error } = await supabase
      .from('moments')
      .select('*')
      .order('occurred_at', { ascending: false })
      .limit(30);
    if (error) { console.error('[LifeOS] 加载瞬间失败:', error); showDemo('读取失败'); return; }
    renderMoments(data || []);
  }

  // ====== 详情弹窗（备用：保留 JS 渲染逻辑，默认不触发） ======
  // 卡片点击不再打开详情弹窗；如后续需要可恢复 inline onclick


  // ====== 添加瞬间 ======
  const modal = document.getElementById('add-modal') as HTMLElement | null;
  const btnAdd = document.getElementById('btn-add');
  const btnCancel = document.getElementById('btn-cancel');
  const form = document.getElementById('add-form') as HTMLFormElement | null;
  const formStatus = document.getElementById('form-status');
  const mediaInput = document.getElementById('media-files') as HTMLInputElement | null;
  const fileList = document.getElementById('file-list');

  if (btnAdd) btnAdd.addEventListener('click', () => openOverlay('add-modal'));
  if (btnCancel) btnCancel.addEventListener('click', () => closeOverlay('add-modal'));

  if (mediaInput) {
    mediaInput.addEventListener('change', () => {
      if (!fileList) return;
      const files = Array.from(mediaInput.files || []);
      fileList.innerHTML = files.map((f) => `<li>● ${escapeHtml(f.name)} (${(f.size / 1024).toFixed(1)} KB)</li>`).join('');
    });
  }

  async function uploadMedia(files: File[]): Promise<string[]> {
    if (!supabase || files.length === 0) return [];
    const urls: string[] = [];
    for (const file of files) {
      const ext = file.name.split('.').pop() || 'bin';
      const path = `moments/${DEFAULT_USER_ID}/${Date.now()}_${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const { error } = await supabase.storage.from('life-os').upload(path, file, {
        cacheControl: '3600', upsert: false, contentType: file.type || 'application/octet-stream',
      });
      if (error) { console.error('[LifeOS] 上传失败:', error); continue; }
      const { data } = supabase.storage.from('life-os').getPublicUrl(path);
      if (data?.publicUrl) urls.push(data.publicUrl);
    }
    return urls;
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!supabase) { if (formStatus) formStatus.textContent = 'Supabase 未配置，无法保存'; return; }
      const fd = new FormData(form);
      const type = String(fd.get('type') || '').trim();
      const title = String(fd.get('title') || '').trim();
      const body = String(fd.get('body') || '').trim();
      const occurred_at = String(fd.get('occurred_at') || '') ? new Date(String(fd.get('occurred_at'))).toISOString() : new Date().toISOString();
      if (!type || !title) { if (formStatus) formStatus.textContent = '请填写类型和标题'; return; }
      if (formStatus) formStatus.textContent = '保存中...';
      const files = mediaInput?.files ? Array.from(mediaInput.files) : [];
      const mediaUrls = files.length > 0 ? await uploadMedia(files) : [];
      const { error } = await supabase.from('moments').insert({
        user_id: DEFAULT_USER_ID, type, title, body: body || null, occurred_at, visibility: 'private', media_urls: mediaUrls.length > 0 ? mediaUrls : [],
      });
      if (error) { if (formStatus) formStatus.textContent = '保存失败：' + escapeHtml(error.message); return; }
      if (formStatus) formStatus.textContent = '已保存';
      form.reset(); if (fileList) fileList.innerHTML = '';
      setTimeout(() => { closeOverlay('add-modal'); loadMoments(); }, 300);
    });
  }

  loadMoments();
</script>
