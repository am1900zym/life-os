---
// src/pages/ai.astro — AI 助手页面
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="AI 助手 — Life OS" active="/ai" pageTitle="AI 助手">
  <section class="ai-context">
    <p class="ai-greeting">你好，<strong>Amanda</strong></p>
    <p class="ai-knows">我了解你的：</p>
    <div class="context-tags">
      <span class="ctx-tag blue">📚 阅读</span>
      <span class="ctx-tag green">🏋 健康</span>
      <span class="ctx-tag gold">💻 学习</span>
      <span class="ctx-tag purple">👥 关系</span>
    </div>
  </section>

  <section class="chat-area">
    <div class="chat-bubble ai" id="chat-history">
      <p>今天想聊什么？我在这里陪你探索人生的下一段旅程。</p>
      <p class="hint">试试下方快捷问题，或直接输入你的问题。</p>
    </div>

    <div class="quick-actions">
      <button class="quick-btn" data-prompt="summarize">“总结我的 2026”</button>
      <button class="quick-btn" data-prompt="strength">“我的优势是什么？”</button>
      <button class="quick-btn" data-prompt="focus">“最近应该关注什么？”</button>
      <button class="quick-btn" data-prompt="friends">“我和朋友的关系变化？”</button>
      <button class="quick-btn" data-prompt="plan">“帮我规划未来一年”</button>
    </div>
  </section>

  <section class="chat-input">
    <div class="input-box">
      <input type="text" id="user-input" placeholder="问 AI 任何关于你人生的问题..." />
      <button class="send-btn" id="send-btn">发送</button>
    </div>
  </section>
</BaseLayout>

<script>
  import { supabase } from '../lib/supabaseClient';

  const chatHistory = document.getElementById('chat-history');
  const userInput = document.getElementById('user-input') as HTMLInputElement | null;
  const sendBtn = document.getElementById('send-btn');

  function addBubble(text: string, who: 'user' | 'ai') {
    if (!chatHistory) return;
    const div = document.createElement('div');
    div.className = 'chat-bubble ' + who;
    div.innerHTML = `<p>${text.replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c] as string))}</p>`;
    chatHistory.appendChild(div);
    chatHistory.scrollTop = chatHistory.scrollHeight;
  }

  async function loadMoments() {
    if (!supabase) return [];
    const { data, error } = await supabase
      .from('moments')
      .select('*')
      .order('occurred_at', { ascending: false })
      .limit(200);
    if (error) { console.error('[AI] moments load error', error); return []; }
    return data ?? [];
  }

  const PROMPTS: Record<string, string> = {
    summarize: '总结我的 2026',
    strength: '我的优势是什么？',
    focus: '最近应该关注什么？',
    friends: '我和朋友的关系变化？',
    plan: '帮我规划未来一年',
  };

  async function handlePrompt(promptKey?: string) {
    const moments = await loadMoments();
    const counts: Record<string, number> = {};
    for (const m of moments) {
      const t = m.type ?? '💡 想法';
      counts[t] = (counts[t] || 0) + 1;
    }
    const total = moments.length || 0;
    const books = Object.entries(counts).filter(([k]) => k.includes('📚') || k.includes('📖')).reduce((s, [, v]) => s + v, 0);
    const workouts = Object.entries(counts).filter(([k]) => k.includes('🏋')).reduce((s, [, v]) => s + v, 0);
    const top = Object.entries(counts).sort((a, b) => b[1] - a[1])[0]?.[0] ?? '暂无数据';

    const key = promptKey || 'custom';
    const text = typeof userInput?.value === 'string' ? userInput.value.trim() : '';
    if (userInput) userInput.value = '';

    const q = text || PROMPTS[key] || '总结我的人生';
    addBubble(q, 'user');

    let reply = '';
    if (key === 'summarize') {
      reply = total > 0
        ? `2026 年你已有 ${total} 个瞬间，最常记录的是「${top}」。如果继续坚持当前节奏，到年底大概率会是「能持续输出」的节奏。`
        : '目前还没有足够的数据做总结。先在首页多记录一些瞬间吧。';
    } else if (key === 'strength') {
      reply = top
        ? `你的当前优势明显在「${top}」方向。另外你在 ${books > 0 ? '📚 阅读' : '💡 记录'} 维度也有持续投入，这通常是长期成长的最大杠杆。`
        : '暂无数据，先记录一些瞬间我才能帮你定位优势。';
    } else if (key === 'focus') {
      reply = workouts > 0
        ? '你已经在「健康」这件事上有证据。建议接下来固定一个输出习惯，哪怕每周一次复盘，都比零散知识更有系统性。'
        : '你目前的记录维度还比较分散。建议接下来先聚焦一个方向连续建立 2 周再切换。';
    } else if (key === 'friends') {
      reply = '目前朋友关系维度数据不足。你可以在「👥」一栏手动标记与朋友相关的瞬间，后续我会自动帮你统计关系频率。';
    } else if (key === 'plan') {
      reply = '基于你当前的上限：先锁 1 个主目标，用 3 个月验证可行，再扩张。你现在同时在做的事太多，砍掉一个才能给真正重要的事留出空间。';
    } else {
      reply = '我暂时只能基于你当前已有记录做粗粒度分析。未来接入大模型 summarizer 后，这句回复会变成更有针对性的建议。';
    }

    setTimeout(() => addBubble(reply, 'ai'), 300 + Math.random() * 200);
  }

  if (sendBtn) {
    sendBtn.addEventListener('click', () => handlePrompt());
  }
  if (userInput) {
    userInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') handlePrompt(); });
  }
  document.querySelectorAll<HTMLButtonElement>('.quick-btn').forEach((btn) => {
    const key = btn.getAttribute('data-prompt') || undefined;
    btn.addEventListener('click', () => handlePrompt(key));
  });
</script>
