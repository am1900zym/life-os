---
// src/pages/friends.astro — 朋友轨道页面
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="朋友轨道 — Life OS" active="/friends">
  <section class="page-header">
    <h1>朋友人生</h1>
    <p class="subtitle">看见朋友的人生，而不是只看朋友圈</p>
  </section>

  <!-- 选择朋友 -->
  <section class="friend-selector">
    <div class="friend-chip checked">
      <span class="chip-avatar">G</span>
      <span class="chip-name">G</span>
    </div>
    <div class="friend-chip checked">
      <span class="chip-avatar">H</span>
      <span class="chip-name">H</span>
    </div>
    <button class="btn-generate">[生成共同轨道]</button>
  </section>

  <!-- 多人并行轨道 -->
  <section class="multi-tracks">
    <h2 class="section-title">2026 并行时间轴</h2>

    <!-- Amanda -->
    <div class="friend-track">
      <div class="track-header">
        <span class="track-avatar">A</span>
        <span class="track-name">Amanda</span>
      </div>
      <div class="track-items">
        <div class="track-item">
          <span class="item-type">📚 AI学习</span>
          <div class="item-bar"><div class="item-fill blue" style="width: 75%"></div></div>
        </div>
        <div class="track-item">
          <span class="item-type">🏋 健身</span>
          <div class="item-bar"><div class="item-fill green" style="width: 60%"></div></div>
        </div>
        <div class="track-item">
          <span class="item-type">☕ 社交</span>
          <div class="item-bar"><div class="item-fill gold" style="width: 45%"></div></div>
        </div>
      </div>
    </div>

    <!-- G -->
    <div class="friend-track">
      <div class="track-header">
        <span class="track-avatar">G</span>
        <span class="track-name">G</span>
      </div>
      <div class="track-items">
        <div class="track-item">
          <span class="item-type">📚 阅读</span>
          <div class="item-bar"><div class="item-fill purple" style="width: 80%"></div></div>
        </div>
        <div class="track-item">
          <span class="item-type">🧑💻 创造</span>
          <div class="item-bar"><div class="item-fill blue" style="width: 55%"></div></div>
        </div>
      </div>
    </div>

    <!-- H -->
    <div class="friend-track">
      <div class="track-header">
        <span class="track-avatar">H</span>
        <span class="track-name">H</span>
      </div>
      <div class="track-items">
        <div class="track-item">
          <span class="item-type">✈️ 旅行</span>
          <div class="item-bar"><div class="item-fill cyan" style="width: 70%"></div></div>
        </div>
        <div class="track-item">
          <span class="item-type">🌟 体验</span>
          <div class="item-bar"><div class="item-fill gold" style="width: 50%"></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- 共享瞬间 -->
  <section class="shared-moments">
    <h2 class="section-title">共同瞬间</h2>
    <div class="shared-badge">📅 2026.07 有 2 个共同瞬间</div>
    <article class="moment-card highlight">
      <span class="moment-type">☕ 社交</span>
      <h3>朋友聚餐</h3>
      <p class="moment-meta">和 G、H 一起 · 7月15日</p>
    </article>
    <article class="moment-card highlight">
      <span class="moment-type">🌟 体验</span>
      <h3>周末爬山</h3>
      <p class="moment-meta">和 G 一起 · 7月22日</p>
    </article>
  </section>
</BaseLayout>
